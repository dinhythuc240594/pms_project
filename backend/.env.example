# Local example only. The setup script creates .env with generated passwords.
# On Coolify configure these values as runtime environment variables.
APP_ENV=development
PORT=5000
DATABASE_URL=postgresql+psycopg://pms_app:CHANGE_ME@127.0.0.1:15432/pms_local
DATABASE_MIGRATION_URL=postgresql+psycopg://pms_migrator:CHANGE_ME@127.0.0.1:15432/pms_local
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Number of reverse proxies in front of the API. Coolify (Traefik) = 1.
# Keep 0 when the API is reached directly, otherwise clients can spoof their IP.
TRUSTED_PROXY_COUNT=0

# Channex: one stable Fernet key shared by API and workers. Generate once with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Back up this key separately from the database; changing it makes saved keys unreadable.
CHANNEX_ENCRYPTION_KEY=
# Optional public HTTPS API origin (no path/query). Enables automatic property webhooks.
CHANNEX_WEBHOOK_BASE_URL=
# Optional system manager sources. Saved per-hotel keys also work in the remote viewer.
# Each key stays on the backend and is used only for its explicit environment.
CHANNEX_MANAGER_API_KEY_STAGING=
CHANNEX_MANAGER_API_KEY_PRODUCTION=
# Hotel owners enter Property ID and API key in OTA settings; never use VITE_ secrets.
# Legacy connections can still read their tenant-scoped SERVER runtime variables:
# CHANNEX_API_KEY_<HOTEL_SCOPE>=your-server-only-api-key
# CHANNEX_WEBHOOK_SECRET_<HOTEL_SCOPE>=a-unique-random-secret
# Never use VITE_ variables for channel secrets. Production does not load .env.
